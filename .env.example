# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. Use a sender address on a domain you have verified in Resend.
RESEND_FROM_EMAIL="Yanish Rai Portfolio <hello@yourdomain.com>"

# Optional: defaults to site.email in data/site.ts
CONTACT_TO_EMAIL=you@example.com

# Optional: paste the token Google Search Console gives you for the HTML-tag method.
GOOGLE_SITE_VERIFICATION=
